package antiSomnolence {
    private import ScalarValues::Boolean;

    action surveillerVigilance {
        attribute contactEtabli : Boolean;
        attribute arretMoteur : Boolean;
        attribute visageDetecte : Boolean;
        attribute analyseValidee : Boolean;

        action initialiserCapteurIR;
        action capturerFluxVisage;
        action calculerPERCLOS;

        merge merge0;
        decide decide0;

        first start;
        succession start if contactEtabli then merge0;
        then initialiserCapteurIR;
        then decide decide0;
            if arretMoteur then done;
            if visageDetecte
                then capturerFluxVisage;
        succession capturerFluxVisage if analyseValidee then calculerPERCLOS;
        then merge0;
    }
}

package tbi {
    private import ScalarValues::Boolean;

    action surveillerVigilance {
        attribute camera : Boolean;
        attribute on : Boolean;
        attribute off : Boolean;
        attribute ouvert : Boolean;
        attribute ferme : Boolean;
        action VerifierNiveauYeux;
        action EnvoyerAlerte;
        decide decide0;
        decide decide1;

        first start;
        succession start if camera then decide0;
            if off then done;
            if on
                then VerifierNiveauYeux;
        succession decide1;
            if ouvert then VerifierNiveauYeux;
            if ferme then EnvoyerAlerte;
        then done;
    }
}
